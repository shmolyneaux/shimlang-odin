class Module:
    types: TypeSection | None = None
    imports: ImportSection | None = None
    functions: FunctionSection | None = None
    tables: TableSection | None = None
    memory: MemorySection | None = None
    tags: TagSection | None = None
    globals: GlobalSection | None = None
    exports: ExportSection | None = None
    start: StartSection | None = None
    elements: ElementSection | None = None
    data_counts: DataCountSection | None = None
    code: CodeSection | None = None
    data: DataSection | None = None
    custom: CustomSection | None = None

    def to_bytes(self) -> bytes:
        preamble = b"\x00\x61\x73\x6d" +  # "\0asm"
                   b"\x01\x00\x00\x00"    # version 1

        b = bytearray()
        b.extend(preamble)

        if self.types:
            b.extend(self.types.to_bytes())

        if self.functions:
            b.extend(self.functions.to_bytes())

        if self.exports:
            b.extend(self.exports.to_bytes())

        if self.code:
            b.extend(self.code.to_bytes())

        return bytes(b)

