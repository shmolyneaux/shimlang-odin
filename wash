class TokenStream:
    def __init__(self, text):
        raw_tokens = re.findall(r'\w+\.\w+|\w+|\(|:|,|\)|->|\n *|#.*', text)
        self.idx = 0
        self.tokens = []

        indents = [""]
        for token_idx in range(len(raw_tokens)):
            token = raw_tokens[token_idx]
            next_token = None if token_idx == len(raw_tokens) - 1 else raw_tokens[token_idx+1]
            if token.startswith("#"):
                continue
            if token.startswith("\n"):
                if token.startswith("\n") and (not next_token or next_token.startswith("\n")):
                    # Skip blank lines
                    continue

                self.tokens.append(Newline())

                indent = token[1:]
                if indent == indents[-1]:
                    # Same indentation level
                    continue

                if len(indent) > len(indents[-1]):
                    # Deeper indentation
                    self.tokens.append(Indent())
                    indents.append(indent)
                    continue

                # It's not the same indentation and it's not longer, so it must
                # be shorter. Figure out how many dedents we need to push based
                # on matching the indents we've collected.

                for idx, block_indent in enumerate(reversed(indents)):
                    if indent == block_indent:
                        assert idx != 0
                        self.tokens.extend(Dedent() for _ in range(idx))
                        indents = indents[:-idx]
                        break

                else:
                    sys.exit("mismatched indent somewhere...")
            else:
                self.tokens.append(token)

    def consume(self, expected=None):
        if self.idx >= len(self.tokens):
            return EOF()

        if expected and self.tokens[self.idx] != expected:
            raise ParseException(f"Couldn't find expected {expected}")
        self.idx += 1
        return self.tokens[self.idx-1]

    def try_consume(self, expected):
        if self.idx >= len(self.tokens):
            return False

        if self.tokens[self.idx] == expected:
            self.idx += 1
            return True
        return False

    def consume_name(self):
        if self.idx >= len(self.tokens):
            return EOF()

        if not self.peek().isalnum():
            raise ParseException(f"Couldn't pick up expected name {self.peek()}")
        self.idx += 1
        return self.tokens[self.idx-1]

    def consume_module_field(self):
        if self.idx >= len(self.tokens):
            return EOF()

        if match := re.match(r"(\w+)\.(\w+)", self.peek()):
            self.idx += 1
            return match.group(1), match.group(2)
        else:
            raise ParseException(f"Couldn't pick up expected module_field {self.peek()}")

    def peek(self):
        if self.idx >= len(self.tokens):
            return EOF()
        return self.tokens[self.idx]

    def peek2(self):
        if self.idx >= len(self.tokens):
            return (EOF(), EOF())
        if self.idx+1 >= len(self.tokens):
            return (self.tokens[self.idx], EOF())
        return (self.tokens[self.idx], self.tokens[self.idx+1])


@dataclass
class IfElseBlock:
    block_type: FuncSignature | None
    if_block: Instructions
    else_block: Instructions | None


@dataclass
class Func:
    export: bool
    name: str
    params: list[tuple[str, str]]
    results: list[str]
    instructions: Instructions
    block_types: list[FuncSignature]
    type_id: int | None = None
    locals: list[tuple[str, str]] = field(default_factory=list)


@dataclass
class ImportFunc:
    module: str
    field: str
    params: list[str]
    results: list[str]
    type_id: int | None = None


@dataclass
class Module:
    imports: list[ImportFunc]
    funcs: list[Func]
    block_types: list[FuncSignature]


Instructions = list[list[str] | IfElseBlock]


def parse_block(tokens: TokenStream) -> tuple[Instructions, list[FuncSignature]]:
    instructions: Instructions = []
    block_types: list[FuncSignature] = []
    while tokens.peek() != EOF():
        # One line ~ one instruction
        inst = []

        start_idx = tokens.idx

        # Get the args in the line. `peek2` is for handling local declarations
        while tokens.peek() not in (":", Newline(), EOF()) and tokens.peek2() != (":", Newline()):
            inst.append(tokens.consume())

        if tokens.try_consume(":"):
            if inst[0] == "if":
                # Rewind parsing to pick up optional params/results
                tokens.idx = start_idx + 1

                signature = None
                if tokens.peek() == "(":
                    params, results = parse_signature(tokens)
                    signature = FuncSignature(params, results)

                tokens.consume(":")
                tokens.consume(Newline())
                tokens.consume(Indent())
                if_block_instructions, if_block_types = parse_block(tokens)

                if tokens.try_consume("else"):
                    tokens.consume(":")
                    tokens.consume(Newline())
                    tokens.consume(Indent())
                    else_block_instructions, else_block_types = parse_block(tokens)

                instructions.append(
                    IfElseBlock(
                        signature,
                        if_block_instructions,
                        else_block_instructions,
                    )
                )
                block_types.extend(if_block_types)
                block_types.extend(else_block_types)

            else:
                sys.exit(f"Token {inst[0]} cannot start a block")

        else:
            instructions.append(inst)
            tokens.consume(Newline())

            if tokens.try_consume(Dedent()):
                break

    return instructions, block_types


def parse_signature(tokens: TokenStream) -> tuple[list[str], list[str]]:
    params = []
    results = []

    tokens.consume("(")
    while not tokens.try_consume(")"):
        param = tokens.consume_name()
        tokens.try_consume(",")
        params.append(param)

    if tokens.try_consume("->"):
        while tokens.peek() not in (":", Newline()):
            results.append(tokens.consume())

    return params, results


def parse(text) -> Module:
    # Smooth-brain parsing

    imports = []
    funcs = []
    block_types: list[FuncSignature] = []

    tokens = TokenStream(text)

    while tokens.peek() != EOF():
        t = tokens.consume()
        if t == Newline():
            continue

        match t:
            case "import":
                module, field = tokens.consume_module_field()
                import_params, results = parse_signature(tokens)
                tokens.consume(NewLine())
                imports.append(ImportFunc(module, field, import_params, results))

            case _ if t.isalnum():
                # Parse fn
                export_fn = False
                name = t
                if t == "export":
                    export_fn = True
                    name = tokens.consume_name()

                tokens.consume("(")

                # Parse params
                params: list[tuple[str, str]] = []
                while not tokens.try_consume(")"):
                    param: str = tokens.consume_name()
                    tokens.try_consume(":")
                    type_name: str = tokens.consume_name()
                    tokens.try_consume(",")

                    params.append((param, type_name))

                # Parse results
                result_types = []
                if tokens.try_consume("->"):
                    while not tokens.try_consume(":"):
                        result_types.append(tokens.consume())
                else:
                    tokens.consume(":")

                tokens.consume(Newline())
                tokens.consume(Indent())

                # Parse instructions
                instructions, new_block_types = parse_block(tokens)

                funcs.append(
                    Func(
                        export_fn,
                        name,
                        params,
                        result_types,
                        instructions,
                        block_types=block_types,
                    )
                )

                block_types.extend(new_block_types)

    return Module(
        imports,
        funcs,
        block_types,
    )


