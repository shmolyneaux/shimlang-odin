#!/usr/bin/env python3
from dataclasses import dataclass, field
import re
import sys
from pathlib import Path

from argparse import ArgumentParser

parser = ArgumentParser()
parser.add_argument("input_file", type=Path)
parser.add_argument("-o", "--output_file", type=Path)

args = parser.parse_args()

if not args.input_file.exists():
    sys.exit(f"Input file {args.input_file} does not exist")

if not args.output_file:
    args.output_file = args.input_file.with_suffix(".wasm")

def uleb(n):
    out = bytearray()
    while True:
        byte = n & 0x7f
        n >>= 7
        if n:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)

def sleb(n):
    out = bytearray()
    while True:
        byte = n & 0x7f
        n >>= 7
        done = (n == 0 and not byte & 0x40) or (n == -1 and byte & 0x40)
        out.append(byte if done else byte | 0x80)
        if done:
            return bytes(out)

class WasmType:
    pass

class FuncSignature:
    params: list[WasmType]
    results: list[WasmType]

    def to_bytes(self) -> bytes:
        b = bytearray()
        b.append("\x60")
        b.extend(uleb(len(self.params)))
        for param in self.params:
            b.extend(param.to_bytes())
        b.extend(uleb(len(self.results)))
        for result in self.results:
            b.extend(result.to_bytes())
        return bytes(b)


class TypeSection:
    types: list[FuncSignature]

    @staticmethod
    def id() -> int:
        return 1

    def to_bytes(self) -> bytes:
        body = bytearray()
        for t in self.types:
            body.extend(t.to_bytes())

        section = bytearray()
        section.append(self.id())
        section.append(uleb(len(body)))
        section.extend(body)

        return bytes(section)


def tokenize(text) -> list[str]:
    result = re.findall(r'\w+\.\w+|\w+|\(|:|,|\)|->|\n *', text)
    print(result)
    sys.exit()
    return result


@dataclass
class Indent:
    pass


@dataclass
class Dedent:
    pass


@dataclass
class Newline:
    pass


@dataclass
class StartBlock:
    pass


@dataclass
class EndBlock:
    pass


@dataclass
class EOF:
    pass


class TokenStream:
    def __init__(self, text):
        raw_tokens = re.findall(r'\w+\.\w+|\w+|\(|:|,|\)|->|\n *|#.*', text)
        self.idx = 0
        self.tokens = []

        indents = [""]
        for token_idx in range(len(raw_tokens)):
            token = raw_tokens[token_idx]
            next_token = None if token_idx == len(raw_tokens) - 1 else raw_tokens[token_idx+1]
            if token.startswith("#"):
                continue
            if token.startswith("\n"):
                if token.startswith("\n") and (not next_token or next_token.startswith("\n")):
                    # Skip blank lines
                    continue

                self.tokens.append(Newline())

                indent = token[1:]
                if indent == indents[-1]:
                    # Same indentation level
                    continue

                if len(indent) > len(indents[-1]):
                    # Deeper indentation
                    self.tokens.append(Indent())
                    indents.append(indent)
                    continue

                # It's not the same indentation and it's not longer, so it must
                # be shorter. Figure out how many dedents we need to push based
                # on matching the indents we've collected.

                for idx, block_indent in enumerate(reversed(indents)):
                    if indent == block_indent:
                        assert idx != 0
                        self.tokens.extend(Dedent() for _ in range(idx))
                        indents = indents[:-idx]
                        break

                else:
                    sys.exit("mismatched indent somewhere...")
            else:
                self.tokens.append(token)

    def consume(self, expected=None):
        if self.idx >= len(self.tokens):
            return EOF()

        if expected and self.tokens[self.idx] != expected:
            sys.exit(f"Couldn't find expected {expected}")
        self.idx += 1
        return self.tokens[self.idx-1]

    def try_consume(self, expected):
        if self.idx >= len(self.tokens):
            return False

        if self.tokens[self.idx] == expected:
            self.idx += 1
            return True
        return False

    def consume_name(self):
        if self.idx >= len(self.tokens):
            return EOF()

        if not self.tokens[self.idx].isalnum():
            sys.exit(f"Couldn't pick up expected name")
        self.idx += 1
        return self.tokens[self.idx-1]

    def peek(self):
        if self.idx >= len(self.tokens):
            return EOF()
        return self.tokens[self.idx]


@dataclass
class Func:
    export: bool
    name: str
    params: list[tuple[str, str]]
    results: list[str]
    instructions: list[list[str] | StartBlock | EndBlock]
    type_id: int | None = None
    locals: list[str] = field(default_factory=list)


@dataclass
class Module:
    funcs: list[Func]


def parse(text) -> Module:
    funcs = []

    tokens = TokenStream(text)

    idx = 0
    while tokens.peek() != EOF():
        t = tokens.consume()
        if t == Newline():
            continue

        if t.isalnum():
            # TODO: parse things other than functions

            export_fn = False
            name = t
            if t == "export":
                export_fn = True
                name = tokens.consume_name()

            tokens.consume("(")

            params = []
            while not tokens.try_consume(")"):
                param = tokens.consume_name()
                tokens.try_consume(":")
                type_name = tokens.consume_name()
                tokens.try_consume(",")

                params.append((param, type_name))

            result_types = []
            if tokens.try_consume("->"):
                while not tokens.try_consume(":"):
                    result_types.append(tokens.consume())

            tokens.consume(Newline())
            tokens.consume(Indent())

            instructions: list[list[str] | StartBlock | EndBlock] = []
            indent_level = 0
            while tokens.peek() != EOF():
                inst = []

                # Get the args in the line
                while tokens.peek() not in (":", Newline(), EOF()):
                    inst.append(tokens.consume())

                instructions.append(inst)

                if tokens.try_consume(":"):
                    tokens.consume(Newline())
                    tokens.consume(Indent())

                    instructions.append(StartBlock())
                    indent_level += 1

                else:
                    tokens.consume(Newline())
                    while tokens.try_consume(Dedent()):
                        indent_level -= 1
                        if indent_level < 0:
                            break
                        instructions.append(EndBlock())
                    if indent_level < 0:
                        break

            funcs.append(
                Func(
                    export_fn,
                    name,
                    params,
                    result_types,
                    instructions,
                )
            )

    return Module(
        funcs,
    )


module = parse(args.input_file.read_text())

fn_types = []
for func in module.funcs:
    signature = ([t for _, t in func.params], func.results)
    if signature not in fn_types:
        func.type_id = len(fn_types)
        fn_types.append(signature)
    else:
        func.type_id = fn_types.index(signature)

preamble = b"\x00\x61\x73\x6d\x01\x00\x00\x00"
b = bytearray()
b.extend(preamble)

type_body = bytearray()
type_body.extend(uleb(len(fn_types)))
for ty in fn_types:
    type_body.append(0x60) # Function type

    params, results = ty
    type_body.extend(uleb(len(params)))
    for param in params:
        if param == "i32":
            type_body.append(0x7f)
        else:
            sys.exit(f"unsupported param type {param}")

    type_body.extend(uleb(len(results)))
    for result in results:
        if result == "i32":
            type_body.append(0x7f)
        else:
            sys.exit(f"unsupported result type {param}")

func_body = bytearray()
func_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    func_body.extend(uleb(func.type_id))

export_body = bytearray()
export_body.extend(uleb(sum(f.export for f in module.funcs)))
for idx, f in enumerate(module.funcs):
    if not f.export:
        continue
    byte_name = f.name.encode()
    export_body.extend(uleb(len(byte_name)))
    export_body.extend(byte_name)
    export_body.append(0x00) # Export a function
    export_body.extend(uleb(idx))

code_body = bytearray()
code_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    inner = bytearray()
    inner.extend(uleb(len(func.locals)))
    for inst in func.instructions:
        assert inst[0] == "i32.const"
        assert len(inst) == 2
        num = int(inst[1])

        inner.append(0x41)
        inner.extend(uleb(num))
    inner.append(0x0b) # end

    code_body.extend(uleb(len(inner)))
    code_body.extend(inner)

b.append(0x01)
b.extend(uleb(len(type_body)))
b.extend(type_body)

b.append(0x03)
b.extend(uleb(len(func_body)))
b.extend(func_body)

b.append(0x07)
b.extend(uleb(len(export_body)))
b.extend(export_body)

b.append(0x0a)
b.extend(uleb(len(code_body)))
b.extend(code_body)

args.output_file.write_bytes(b)
