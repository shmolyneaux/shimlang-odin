module = parse(args.input_file.read_text())

block_types: list[tuple[list[str], list[str]]] = []
for import_item in module.imports:
    signature = (import_item.params, import_item.results)
    if signature not in block_types:
        import_item.type_id = len(block_types)
        block_types.append(signature)
    else:
        import_item.type_id = block_types.index(signature)

for func in module.funcs:
    signature = ([t for _, t in func.params], func.results)
    if signature not in block_types:
        func.type_id = len(block_types)
        block_types.append(signature)
    else:
        func.type_id = block_types.index(signature)

    for block_type in func.block_types:
        signature = (block_type.params, block_types.results)
        if signature not in block_types:
            block_types.append(signature)

preamble = b"\x00\x61\x73\x6d\x01\x00\x00\x00"
b = bytearray()
b.extend(preamble)

type_body = bytearray()
type_body.extend(uleb(len(block_types)))
for ty in block_types:
    type_body.append(0x60) # Function type

    params, results = ty
    type_body.extend(uleb(len(params)))
    for param in params:
        type_body.append(type_name_to_id(param))

    type_body.extend(uleb(len(results)))
    for result in results:
        type_body.append(type_name_to_id(result))

fn_lookup: dict[str, int] = {}
import_body = bytearray()
import_body.extend(uleb(len(module.imports)))
for idx, import_item in enumerate(module.imports):
    byte_name = import_item.module.encode()
    import_body.extend(uleb(len(byte_name)))
    import_body.extend(byte_name)

    byte_name = import_item.field.encode()
    import_body.extend(uleb(len(byte_name)))
    import_body.extend(byte_name)

    import_body.append(0x00) # Import a function
    import_body.extend(uleb(import_item.type_id))

    assert import_item.field not in fn_lookup
    fn_lookup[import_item.field] = len(fn_lookup)

func_body = bytearray()
func_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    func_body.extend(uleb(func.type_id))

export_body = bytearray()
export_body.extend(uleb(sum(f.export for f in module.funcs)))
for idx, f in enumerate(module.funcs):
    assert f.name not in fn_lookup
    fn_idx = len(fn_lookup)
    fn_lookup[f.name] = fn_idx
    if not f.export:
        continue

    byte_name = f.name.encode()
    export_body.extend(uleb(len(byte_name)))
    export_body.extend(byte_name)
    export_body.append(0x00) # Export a function
    export_body.extend(uleb(fn_idx))


def assemble(inst: Instruction) -> list[int]:
    inner = []
    match inst:
        case IfElseBlock(
            if_signature,
            if_block_instructions,
            else_block_instructions,
        ):
            inner.append(0x04)
            if not if_signature.params and not if_signature.results:
                inner.append(0x40)
            elif not if_signature.params and len(if_signature.results) == 1:
                inner.append(type_name_to_id(if_signature.results[0]))
            else:
                type_id = None
                for idx, sig in enumerate(fn_types):
                    if sig == if_signature:
                        type_id = idx
                assert type_id is not None
                inner.extend(sleb(type_id))

            for block_inst in if_block_instructions:
                inner.extend(assemble(block_inst))

            if else_block_instructions:
                inner.append(0x05)
                for block_inst in else_block_instructions:
                    inner.extend(assemble(block_inst))

            inner.append(0x0b)

        case ["i32.const", *_]:
            assert len(inst) == 2
            num = int(inst[1])

            inner.append(0x41)
            inner.extend(uleb(num))

        case ["local.get", *_]:
            assert len(inst) == 2
            assert inst[1] in local_lookup

            inner.append(0x20)
            inner.extend(uleb(local_lookup[inst[1]]))

        case ["i32.gt_s", *_]:
            assert len(inst) == 1
            inner.append(0x4a)

        case ["select", *_]:
            assert len(inst) == 1
            inner.append(0x1b)

        case ["call", *_]:
            assert len(inst) == 2
            if inst[1] not in fn_lookup:
                sys.exit(f"Unknown fn {inst[1]}")
            inner.append(0x10)
            inner.extend(uleb(fn_lookup[inst[1]]))

        case _:
            sys.exit(f"Unknown instruction `{inst}`")

    return inner

code_body = bytearray()
code_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    local_names = [name for name, _ in func.params] + [name for name, _ in func.locals]
    local_lookup = {name: idx for idx, name in enumerate(local_names)}
    inner = bytearray()
    inner.extend(uleb(len(func.locals)))
    for inst in func.instructions:
        inner.extend(assemble(inst))
    inner.append(0x0b) # end

    code_body.extend(uleb(len(inner)))
    code_body.extend(inner)

b.append(0x01)
b.extend(uleb(len(type_body)))
b.extend(type_body)

b.append(0x02)
b.extend(uleb(len(import_body)))
b.extend(import_body)

b.append(0x03)
b.extend(uleb(len(func_body)))
b.extend(func_body)

b.append(0x07)
b.extend(uleb(len(export_body)))
b.extend(export_body)

b.append(0x0a)
b.extend(uleb(len(code_body)))
b.extend(code_body)

args.output_file.write_bytes(b)
