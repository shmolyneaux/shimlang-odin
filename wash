    "i31.get_u"                : [0xfb, 0x1e],
    "v128.load"                : [0xfd, 0x0],
    "v128.store"               : [0xfd, 0xb],
    "i8x16.shuffle"            : [0xfd, 0xd],
    "i8x16.swizzle"            : [0xfd, 0xe],
    "i32x4.splat"              : [0xfd, 0x11],
    "f32x4.splat"              : [0xfd, 0x13],
    "i32x4.extract_lane"       : [0xfd, 0x1b],
    "f32x4.extract_lane"       : [0xfd, 0x1f],
    "i32x4.replace_lane"       : [0xfd, 0x1c],
    "v128.and"                 : [0xfd, 0x4e],
    "v128.bitselect"           : [0xfd, 0x52],
    "v128.any_true"            : [0xfd, 0x53],
    "i32x4.all_true"           : [0xfd, 0xa3, 0x1],
    "i32x4.add"                : [0xfd, 0xae, 0x1],
    "i32x4.mul"                : [0xfd, 0xb5, 0x1],
    "f32x4.add"                : [0xfd, 0xe4, 0x1],
    "f32x4.mul"                : [0xfd, 0xe6, 0x1],
    "f32x4.div"                : [0xfd, 0xe7, 0x1],
    "f32x4.sqrt"               : [0xfd, 0xe3, 0x1],
    "f32x4.lt"                 : [0xfd, 0x43],
    "v128.load32_splat"        : [0xfd, 0x9],
    "f32x4.relaxed_madd"       : [0xfd, 0x85, 0x2],
    "memory.atomic.notify"     : [0xfe, 0x0],
    "memory.atomic.wait32"     : [0xfe, 0x1],
    "atomic.fence"             : [0xfe, 0x3],
    "i32.atomic.load"          : [0xfe, 0x10],
    "i32.atomic.store"         : [0xfe, 0x17],
    "i32.atomic.rmw.add"       : [0xfe, 0x1e],
    "i32.atomic.rmw.cmpxchg"   : [0xfe, 0x48],
}

def assemble(inst: Instruction, local_lookup: dict[str, int], block_label: list[str | None]) -> list[int]:
    inner = []
    match inst:
        case IfElseBlock(
            if_signature,
            if_block_instructions,
            else_block_instructions,
        ):
            inner.append(0x04)
            inner.extend(signature_to_type_id(if_signature))

            for block_inst in if_block_instructions:
                inner.extend(assemble(block_inst, local_lookup, block_label + [None]))

            if else_block_instructions:
                inner.append(0x05)
                for block_inst in else_block_instructions:
                    inner.extend(assemble(block_inst, local_lookup, block_label + [None]))

            inner.append(0x0b)

        case LoopBlock(label, signature, block):
            inner.append(0x03)
            inner.extend(signature_to_type_id(signature))

            for block_inst in block:
                inner.extend(assemble(block_inst, local_lookup, block_label + [label]))

            inner.append(0x0b)

        case Block(label, signature, block):
            inner.append(0x02)
            inner.extend(signature_to_type_id(signature))

            for block_inst in block:
                inner.extend(assemble(block_inst, local_lookup, block_label + [label]))

            inner.append(0x0b)

        case ["br", label]:
            assert label in block_label
            inner.append(0x0c)
            inner.append(len(block_label) - block_label.index(label) - 1)

        case ["br_if", label]:
            assert label in block_label
            inner.append(0x0d)
            inner.append(len(block_label) - block_label.index(label) - 1)

        case ["drop"]:
            inner.append(0x1a)

        case ["i32.const", str(val)]:
            num = int(val, 0)
            inner.append(0x41)
            inner.extend(sleb(num))

        case ["i64.const", str(val)]:
            num = int(val, 0)
            inner.append(0x42)
            inner.extend(sleb(num))

        case ["f32.const", str(val)]:
            num = float(inst[1])
            inner.append(0x43)
            inner.extend(struct.pack('<f', num))

        case ["f64.const", str(val)]:
            num = float(inst[1])
            inner.append(0x44)
            inner.extend(struct.pack('<d', num))

        case ["local.get", *_]:
            assert len(inst) == 2
            assert inst[1] in local_lookup

            inner.append(0x20)
            inner.extend(uleb(local_lookup[inst[1]]))

        case ["local.set", *_]:
            assert len(inst) == 2
            assert inst[1] in local_lookup

            inner.append(0x21)
            inner.extend(uleb(local_lookup[inst[1]]))

        case ["local.tee", *_]:
            assert len(inst) == 2
            assert inst[1] in local_lookup

            inner.append(0x22)
            inner.extend(uleb(local_lookup[inst[1]]))

        case [str(op)] if code := op_table.get(op):
            inner.extend(code)

        case ["call", func_label]:
            if func_label not in fn_lookup:
                sys.exit(f"Unknown fn {func_label}")
            inner.append(0x10)
            inner.extend(uleb(fn_lookup[func_label]))

        case _:
            sys.exit(f"Unknown instruction `{inst}`")

    return inner

code_body = bytearray()
code_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    local_names = [name for name, _ in func.params]
    local_lookup = {name: idx for idx, name in enumerate(local_names)}
    inner = bytearray()

    locals_done = False
    local_types = []
    for inst in func.instructions:
        if not locals_done:
            match inst:
                case [str(local_name), ":", str(type_name)]:
                    assert local_name not in local_lookup
                    local_lookup[local_name] = len(local_lookup)
                    local_types.append(type_name)
                    continue
                case _:
                    groups = consecutive_counts(local_types)
                    inner.extend(uleb(len(groups)))
                    for count, type_name in groups:
                        inner.extend(uleb(count))
                        inner.append(type_name_to_id(type_name))
                    locals_done = True
        inner.extend(assemble(inst, local_lookup, []))
    inner.append(0x0b) # end

    code_body.extend(uleb(len(inner)))
    code_body.extend(inner)

b.append(0x01)
b.extend(uleb(len(type_body)))
b.extend(type_body)

b.append(0x02)
b.extend(uleb(len(import_body)))
b.extend(import_body)

b.append(0x03)
b.extend(uleb(len(func_body)))
b.extend(func_body)

b.append(0x07)
b.extend(uleb(len(export_body)))
b.extend(export_body)

b.append(0x0a)
b.extend(uleb(len(code_body)))
b.extend(code_body)

args.output_file.write_bytes(b)
