Instructions = list[list[str] | IfElseBlock | LoopBlock | Block]


def parse_block(tokens: TokenStream) -> tuple[Instructions, list[FuncSignature]]:
    instructions: Instructions = []
    block_types: list[FuncSignature] = []
    while tokens.peek() != EOF():
        # One line ~ one instruction
        inst = []

        start_idx = tokens.idx

        # Get the args in the line. `peek2` is for handling local declarations
        while tokens.peek() not in (Newline(), EOF()) and tokens.peek2() != (":", Newline()):
            inst.append(tokens.consume())

        if tokens.try_consume(":"):
            # Rewind parsing to pick up optional params/results
            tokens.idx = start_idx + 1
            label = tokens.maybe_consume_name()
            signature = None
            if tokens.peek() == "(":
                params, results = parse_signature(tokens)
                signature = FuncSignature(params, results)
                block_types.append(signature)

            tokens.consume(":")
            tokens.consume(Newline())
            tokens.consume(Indent())

            block_instructions, new_block_types = parse_block(tokens)
            block_types.extend(new_block_types)

            if inst[0] == "if":
                else_block_instructions = []
                if tokens.try_consume("else"):
                    tokens.consume(":")
                    tokens.consume(Newline())
                    tokens.consume(Indent())
                    else_block_instructions, else_block_types = parse_block(tokens)
                    block_types.extend(else_block_types)

                instructions.append(
                    IfElseBlock(
                        signature,
                        block_instructions,
                        else_block_instructions,
                    )
                )

            elif inst[0] == "loop":
                instructions.append(
                    LoopBlock(
                        label,
                        signature,
                        block_instructions,
                    )
                )

            elif inst[0] == "block":
                instructions.append(
                    Block(
                        label,
                        signature,
                        block_instructions,
                    )
                )

            else:
                sys.exit(f"Token {inst[0]} cannot start a block")

        else:
            instructions.append(inst)
            tokens.consume(Newline())

            if tokens.try_consume(Dedent()):
                break

    return instructions, block_types


def parse_signature(tokens: TokenStream) -> tuple[list[str], list[str]]:
    params = []
    results = []

    tokens.consume("(")
    while not tokens.try_consume(")"):
        param = tokens.consume_name()
        tokens.try_consume(",")
        params.append(param)

    if tokens.try_consume("->"):
        while tokens.peek() not in (":", Newline()):
            results.append(tokens.consume())

    return params, results


def parse(text) -> Module:
    # Smooth-brain parsing

    imports = []
    funcs = []
    block_types: list[FuncSignature] = []

    tokens = TokenStream(text)

    while tokens.peek() != EOF():
        t = tokens.consume()
        if t == Newline():
            continue

        match t:
            case "import":
                module, field = tokens.consume_module_field()
                import_params, results = parse_signature(tokens)
                tokens.consume(Newline())
                imports.append(ImportFunc(module, field, import_params, results))

            case _ if t.replace("_", "a").isalnum():
                # Parse fn
                export_fn = False
                name = t
                if t == "export":
                    export_fn = True
                    name = tokens.consume_name()

                tokens.consume("(")

                # Parse params
                params: list[tuple[str, str]] = []
                while not tokens.try_consume(")"):
                    param: str = tokens.consume_name()
                    tokens.try_consume(":")
                    type_name: str = tokens.consume_name()
                    tokens.try_consume(",")

                    params.append((param, type_name))

                # Parse results
                result_types = []
                if tokens.try_consume("->"):
                    while not tokens.try_consume(":"):
                        result_types.append(tokens.consume())
                else:
                    tokens.consume(":")

                tokens.consume(Newline())
                tokens.consume(Indent())

                # Parse instructions
                instructions, new_block_types = parse_block(tokens)

                funcs.append(
                    Func(
                        export_fn,
                        name,
                        params,
                        result_types,
                        instructions,
                        block_types=block_types,
                    )
                )

                block_types.extend(new_block_types)

    return Module(
        imports,
        funcs,
        block_types,
    )


def type_name_to_id(s: str) -> int:
    match s:
        case "i32":
            return 0x7f
        case "i64":
            return 0x7e
        case "f32":
            return 0x7d
        case "f64":
            return 0x7c
        case _:
            sys.exit(f"unsupported result type {s}")


module = parse(args.input_file.read_text())

block_types: list[tuple[list[str], list[str]]] = []
for import_item in module.imports:
    signature = (import_item.params, import_item.results)
    if signature not in block_types:
        import_item.type_id = len(block_types)
        block_types.append(signature)
    else:
        import_item.type_id = block_types.index(signature)

for func in module.funcs:
    signature = ([t for _, t in func.params], func.results)
    if signature not in block_types:
        func.type_id = len(block_types)
        block_types.append(signature)
    else:
        func.type_id = block_types.index(signature)

    for block_type in func.block_types:
        signature = (block_type.params, block_types.results)
        if signature not in block_types:
            block_types.append(signature)

preamble = b"\x00\x61\x73\x6d\x01\x00\x00\x00"
b = bytearray()
b.extend(preamble)

type_body = bytearray()
type_body.extend(uleb(len(block_types)))
for ty in block_types:
    type_body.append(0x60) # Function type

    params, results = ty
    type_body.extend(uleb(len(params)))
    for param in params:
        type_body.append(type_name_to_id(param))

    type_body.extend(uleb(len(results)))
    for result in results:
        type_body.append(type_name_to_id(result))

fn_lookup: dict[str, int] = {}
import_body = bytearray()
import_body.extend(uleb(len(module.imports)))
for idx, import_item in enumerate(module.imports):
    byte_name = import_item.module.encode()
    import_body.extend(uleb(len(byte_name)))
    import_body.extend(byte_name)

    byte_name = import_item.field.encode()
    import_body.extend(uleb(len(byte_name)))
    import_body.extend(byte_name)

    import_body.append(0x00) # Import a function
    import_body.extend(uleb(import_item.type_id))

    assert import_item.field not in fn_lookup
    fn_lookup[import_item.field] = len(fn_lookup)

func_body = bytearray()
func_body.extend(uleb(len(module.funcs)))
for func in module.funcs:
    func_body.extend(uleb(func.type_id))

export_body = bytearray()
export_body.extend(uleb(sum(f.export for f in module.funcs)))
for idx, f in enumerate(module.funcs):
    assert f.name not in fn_lookup
    fn_idx = len(fn_lookup)
    fn_lookup[f.name] = fn_idx
    if not f.export:
        continue

    byte_name = f.name.encode()
    export_body.extend(uleb(len(byte_name)))
    export_body.extend(byte_name)
    export_body.append(0x00) # Export a function
    export_body.extend(uleb(fn_idx))


def signature_to_type_id(signature: FuncSignature | None) -> list[int]:
    if not signature or (not signature.params and not signature.results):
        return [0x40]
    elif not signature.params and len(signature.results) == 1:
        return [type_name_to_id(signature.results[0])]
    else:
        type_id = None
        for idx, sig in enumerate(fn_types):
            if sig == signature:
                return sleb(idx)
    raise ParseException(f"No type_id for {signature}")

