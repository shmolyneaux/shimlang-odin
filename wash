def consecutive_counts(items: list[str]) -> list(tuple[int, str]):
    if not items:
        return []

    result = []

    count = 1
    for idx, item in enumerate(items):
        if idx == 0:
            continue
        prev_item = items[idx-1]
        if item != prev_item:
            result.append((count, prev_item))
            count = 0
        count += 1
    result.append((count, items[-1]))

    return result

assert consecutive_counts([]) == []
assert consecutive_counts(["i32"]) == [(1, "i32")]
assert consecutive_counts(["i32", "i32"]) == [(2, "i32")]
assert consecutive_counts(["i32", "i32", "f32"]) == [(2, "i32"), (1, "f32")]
assert consecutive_counts(["i32", "i32", "f32", "i32"]) == [(2, "i32"), (1, "f32"), (1, "i32")]
assert consecutive_counts(["i32", "i32", "f32", "i32", "i32"]) == [(2, "i32"), (1, "f32"), (2, "i32")]

def uleb(n):
    out = bytearray()
    while True:
        byte = n & 0x7f
        n >>= 7
        if n:
            out.append(byte | 0x80)
        else:
            out.append(byte)
            return bytes(out)

def sleb(n):
    out = bytearray()
    while True:
        byte = n & 0x7f
        n >>= 7
        done = (n == 0 and not byte & 0x40) or (n == -1 and byte & 0x40)
        out.append(byte if done else byte | 0x80)
        if done:
            return bytes(out)

